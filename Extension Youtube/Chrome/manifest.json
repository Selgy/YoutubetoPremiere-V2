{
    "manifest_version": 3,
    "name": "Youtube to Premiere Pro V3",
    "version": "3.0.37",
    "description": "Import videos from YouTube, TikTok, Instagram, X and Dailymotion into Adobe Premiere Pro.",
    "permissions": [
        "activeTab",
        "storage",
        "cookies"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://*.google.com/*",
        "https://*.googleapis.com/*",
        "http://localhost/*",
        "https://api.github.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://*.dailymotion.com/*"
    ],
    "action": {
        "default_icon": {
            "48": "icon.png"
        },
        "default_popup": "popup.html",
        "default_title": "YouTube to Premiere - Settings"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://*.tiktok.com/*",
                "https://*.instagram.com/*",
                "https://x.com/*",
                "https://*.x.com/*",
                "https://twitter.com/*",
                "https://*.twitter.com/*",
                "https://*.dailymotion.com/*"
            ],
            "js": [
                "socket.io.min.js",
                "i18n.js",
                "sites.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icon.png"
            ],
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://*.tiktok.com/*",
                "https://*.instagram.com/*",
                "https://x.com/*",
                "https://*.x.com/*",
                "https://twitter.com/*",
                "https://*.twitter.com/*",
                "https://*.dailymotion.com/*"
            ]
        }
    ],
    "icons": {
        "48": "icon.png"
    }
}
