{
    "manifest_version": 2,
    "name": "Youtube to Premiere Pro V3 (Firefox)",
    "version": "3.0.37",
    "description": "Download and import videos from YouTube, TikTok, Instagram, X and Dailymotion straight into Adobe Premiere Pro. Talks to the local application on localhost:17845.",
    "permissions": [
        "activeTab",
        "storage",
        "cookies",
        "https://www.youtube.com/*",
        "https://youtu.be/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.google.com/*",
        "https://*.googleapis.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://api.github.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://*.dailymotion.com/*"
    ],
    "browser_action": {
        "default_icon": {
            "48": "icon.png"
        },
        "default_popup": "popup.html",
        "default_title": "YouTube to Premiere - Settings"
    },
    "background": {
        "scripts": [
            "sites.js",
            "background.js"
        ],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://youtube.com/*",
                "https://*.tiktok.com/*",
                "https://*.instagram.com/*",
                "https://x.com/*",
                "https://*.x.com/*",
                "https://twitter.com/*",
                "https://*.twitter.com/*",
                "https://*.dailymotion.com/*"
            ],
            "js": [
                "socket.io.min.js",
                "i18n.js",
                "sites.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        "icon.png"
    ],
    "icons": {
        "48": "icon.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "youtube-to-premiere-v3@extension",
            "strict_min_version": "109.0"
        }
    }
}
